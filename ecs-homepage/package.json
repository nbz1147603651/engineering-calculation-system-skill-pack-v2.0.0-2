{
  "name": "ecs-homepage",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "version:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-version.ps1",
    "version:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-version.ps1",
    "package:static": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-static.ps1",
    "package:linux-web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-static.ps1",
    "docker:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-build.ps1",
    "docker:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
