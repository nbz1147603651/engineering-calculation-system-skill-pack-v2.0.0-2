server {
    listen 80;
    listen [::]:80;
    server_name __ECS_HOMEPAGE_SERVER_NAME__;
    server_tokens off;

    root __ECS_HOMEPAGE_SITE_ROOT__;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com data:" always;

    location ~ /\. {
        deny all;
        return 404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /home {
        return 301 /home/;
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }

    location /home/assets/ {
        expires 30d;
        try_files $uri =404;
    }

    location /downloads/ {
        alias __ECS_HOMEPAGE_SITE_ROOT__/data/;
        expires 7d;
    }

    location /home/ {
        try_files $uri $uri/ /home/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
